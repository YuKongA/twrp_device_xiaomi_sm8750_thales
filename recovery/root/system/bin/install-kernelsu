#!/system/bin/sh

set -eu

TOOLS=/root-tools
WORK=/tmp/kernelsu-install
KMI=android15-6.6

log() {
    echo "KernelSU: $*"
    echo "I:KernelSU installer: $*" >> /tmp/recovery.log
}

fail() {
    log "ERROR: $*"
    exit 1
}

case "$(uname -r)" in
    6.6.*-android15-*) ;;
    *) fail "Unsupported kernel: $(uname -r)" ;;
esac

suffix="$(getprop ro.boot.slot_suffix)"
case "$suffix" in
    _a|_b) ;;
    *) fail "Cannot determine the active slot" ;;
esac

target="/dev/block/bootdevice/by-name/init_boot${suffix}"
[ -b "$target" ] || fail "Missing active init_boot partition: $target"
chmod 0755 "$TOOLS/ksud" 2>/dev/null || fail "Unable to make ksud executable"
[ -x "$TOOLS/ksud" ] || fail "Missing ksud"
[ -f "$TOOLS/kernelsu.ko" ] || fail "Missing KernelSU LKM"

if grep -a -q -E 'MAGISK|magisk' "$target"; then
    fail "The active init_boot is patched by Magisk. Restore stock init_boot first."
fi

rm -rf "$WORK"
mkdir -p "$WORK"

log "Backing up active init_boot${suffix}"
dd if="$target" of="$WORK/init_boot-stock.img" bs=4M 2>> /tmp/recovery.log || \
    fail "Unable to read init_boot${suffix}"

if mountpoint -q /data && [ -d /data/media/0 ]; then
    backup_dir=/data/media/0/TWRP/RootBackups
    mkdir -p "$backup_dir"
    mkdir -p /data/media/0/Download
    cp "$WORK/init_boot-stock.img" "$backup_dir/init_boot${suffix}-before-kernelsu.img"
    cp "$TOOLS/KernelSU.apk" /data/media/0/Download/KernelSU-v3.2.5.apk 2>/dev/null || true
    log "Backup saved to internal storage/TWRP/RootBackups"
fi

log "Patching init_boot${suffix} in LKM mode"
status_file="$WORK/boot-patch.status"
(
    set +e
    "$TOOLS/ksud" boot-patch \
        --boot "$WORK/init_boot-stock.img" \
        --module "$TOOLS/kernelsu.ko" \
        --partition init_boot \
        --kmi "$KMI" \
        --out "$WORK" \
        --out-name init_boot-kernelsu.img
    echo "$?" > "$status_file"
) 2>&1
[ -f "$status_file" ] || fail "Unable to obtain ksud exit status"
[ "$(cat "$status_file")" -eq 0 ] || fail "ksud boot-patch failed"

patched="$WORK/init_boot-kernelsu.img"
[ -s "$patched" ] || fail "Patched init_boot image was not created"

partition_size="$(blockdev --getsize64 "$target")"
image_size="$(stat -c %s "$patched")"
[ "$image_size" -le "$partition_size" ] || fail "Patched image exceeds init_boot size"

log "Writing patched init_boot${suffix}"
dd if="$patched" of="$target" bs=4M conv=fsync 2>> /tmp/recovery.log || \
    fail "Unable to write init_boot${suffix}"
sync
log "KernelSU v3.2.5 installed successfully"
